PROJECT_NAME="Campus Lost & Found Portal"
API_V1_STR="/api/v1"
SECRET_KEY="campus-lost-and-found-super-secret-jwt-key-change-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# MongoDB Atlas Connection URI
# e.g.: mongodb+srv://<username>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI="mongodb://localhost:27017"
DATABASE_NAME="lost_and_found_db"

# Development Moderation Toggle (True = auto-publishes reports for quick testing, False = full admin review)
AUTO_APPROVE_REPORTS=False

# Media & Upload Settings
UPLOAD_DIR="uploads"
MAX_FILE_SIZE_MB=5
ALLOWED_EXTENSIONS=["jpg", "jpeg", "png", "webp"]

# QR Token Lifetime (Hours)
QR_TOKEN_EXPIRE_HOURS=48

# CORS
BACKEND_CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000"]
